# Copy this file to `.env` on the workstation. Do NOT commit .env.
#
# Read by docker compose and by scripts/start_groot.sh on the AWS workstation.

# NVIDIA NGC API key. Generate at https://ngc.nvidia.com/setup/api-keys.
# Used by `docker login nvcr.io` to pull the GR00T base image (pytorch:25.01-py3).
NGC_API_KEY=

# Hugging Face token. Generate at https://huggingface.co/settings/tokens.
# Read access is enough; you must accept the NVIDIA Open Model License at
# https://huggingface.co/nvidia/GR00T-N1.7-3B before downloads succeed.
HF_TOKEN=

# Acknowledgements required by NVIDIA NGC images. Do not change.
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
